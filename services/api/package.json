{
  "name": "@staq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migration:run": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migration:revert": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "migration:generate": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "migration:create": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@google/generative-ai": "^0.24.1",
    "@staq/shared": "workspace:*",
    "@supabase/supabase-js": "^2.95.3",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.22.0",
    "pg": "^8.18.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "tiktoken": "^1.0.22",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@staq/eslint-config": "workspace:*",
    "@staq/tsconfig": "workspace:*",
    "@types/babel__traverse": "^7.28.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
