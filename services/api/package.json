{
  "name": "@staq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migration:revert": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "migration:generate": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "migration:create": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "@staq/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "pg": "^8.18.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@staq/eslint-config": "workspace:*",
    "@staq/tsconfig": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
