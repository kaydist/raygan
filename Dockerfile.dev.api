# =============================================================================
# Raygan API - Development Dockerfile (hot reload via tsx watch)
# =============================================================================
FROM node:22-alpine

# Fix TLS 1.3 handshake failure with Cloudflare-fronted hosts in Docker Desktop
ENV NODE_OPTIONS="--dns-result-order=ipv4first --tls-max-v1.2"

RUN apk add --no-cache libc6-compat ca-certificates git

WORKDIR /app

# Copy workspace config
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./

# Copy package.json files for dependency resolution
COPY packages/shared/package.json ./packages/shared/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/tsconfig/ ./packages/tsconfig/
COPY services/api/package.json ./services/api/

# Copy source code (will be overridden by volume mounts for hot reload)
COPY packages/shared ./packages/shared
COPY services/api ./services/api

# Copy entrypoint
COPY docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 4000

WORKDIR /app/services/api

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/app/services/api/node_modules/.bin/tsx", "watch", "--env-file=.env", "src/index.ts"]
